+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import vectors from './__fixtures__/vectors.json';
+import { getAppleAppSiteAssociation, getPasskeyAssetLinks } from './association';
+import { base64UrlDecode, base64UrlEncode, encodeEnvelope } from './envelope';
+import { mailboxChannel, mailboxKeyBytes, prfSalt, sealMailbox } from './mailbox';
+import { buildPasskeyRequest, getPasskeyAssertion, isPasskeySignInSupported, PasskeyCeremonyError } from './passkey';
+
+vi.mock('@/libs/pwa/platform', () => ({
+  isIosDevice: vi.fn(() => false),
+  isAndroidIntentDevice: vi.fn(() => true),
+}));
+
+const hex = (bytes: Uint8Array) => Buffer.from(bytes).toString('hex');
+const fromHex = (value: string) => new Uint8Array(Buffer.from(value, 'hex'));
+const RP_ID = vectors.mailbox.rpId;
+
+describe('passkey envelope', () => {
+  it('matches the vector shared with Pubky Ring', () => {
+    const { input } = vectors.envelope;
+    const encoded = encodeEnvelope({ ...input, nonce: fromHex(input.nonce) });
+    expect(hex(encoded)).toBe(vectors.envelope.hex);
+    expect(base64UrlEncode(encoded)).toBe(vectors.envelope.base64url);
+    expect(hex(base64UrlDecode(vectors.envelope.base64url))).toBe(vectors.envelope.hex);
+  });
+
+  it('rejects a nonce of the wrong length', () => {
+    expect(() => encodeEnvelope({ exp: 1, nonce: new Uint8Array(8), url: 'pubkyauth://x' })).toThrow();
+  });
+});
+
+describe('passkey mailbox', () => {
+  it('derives the salt, key and channel shared with Pubky Ring', async () => {
+    const salt = await prfSalt(fromHex(vectors.mailbox.prfInputHex));
+    expect(hex(salt)).toBe(vectors.mailbox.prfSaltHex);
+    expect(hex(await mailboxKeyBytes(salt))).toBe(vectors.mailbox.keyHex);
+    expect(await mailboxChannel(salt)).toBe(vectors.mailbox.channel);
+  });
+
+  it('seals the envelope exactly as Pubky Ring expects', async () => {
+    const sealed = await sealMailbox({
+      prfInput: fromHex(vectors.mailbox.prfInputHex),
+      envelope: fromHex(vectors.envelope.hex),
+      rpId: RP_ID,
+      gcmNonce: fromHex(vectors.mailbox.gcmNonceHex),
+    });
+    expect(sealed.channel).toBe(vectors.mailbox.channel);
+    expect(hex(sealed.body)).toBe(vectors.mailbox.bodyHex);
+  });
+});
+
+describe('buildPasskeyRequest', () => {
+  const authorizationUrl = vectors.envelope.input.url;
+
+  it('puts the envelope in the challenge with an empty allow list (Android)', async () => {
+    const { options, envelope, mailbox } = await buildPasskeyRequest({
+      authorizationUrl,
+      rpId: RP_ID,
+      route: 'challenge',
+      nowSeconds: 1000,
+    });
+    const publicKey = options.publicKey!;
+    expect(publicKey.rpId).toBe(RP_ID);
+    expect(publicKey.challenge).toBe(envelope);
+    expect(publicKey.allowCredentials).toEqual([]);
+    expect(new TextDecoder().decode(envelope.subarray(0, 6))).toBe('PKYWA1');
+    expect(new DataView(envelope.buffer).getUint32(8)).toBe(1120);
+    expect(mailbox).toBeUndefined();
+  });
+
+  it('adds a mailbox on the iOS route', async () => {
+    const { mailbox, options } = await buildPasskeyRequest({ authorizationUrl, rpId: RP_ID, route: 'mailbox' });
+    expect(mailbox?.channel).toMatch(/^[A-Za-z0-9_-]{43}$/);
+    const prf = (options.publicKey!.extensions as { prf: { eval: { first: Uint8Array } } }).prf;
+    expect(prf.eval.first).toHaveLength(32);
+  });
+
+  it('sends the envelope as a credential ID on the allowCredentials route', async () => {
+    const { options, envelope } = await buildPasskeyRequest({
+      authorizationUrl,
+      rpId: RP_ID,
+      route: 'allowCredentials',
+    });
+    expect(options.publicKey!.allowCredentials).toEqual([{ type: 'public-key', id: envelope }]);
+  });
+});
+
+describe('getPasskeyAssertion', () => {
+  const originalCredentials = navigator.credentials;
+
+  afterEach(() => {
+    Object.defineProperty(navigator, 'credentials', { value: originalCredentials, configurable: true });
+  });
+
+  const mockGet = (impl: () => Promise<unknown>) => {
+    Object.defineProperty(navigator, 'credentials', { value: { get: vi.fn(impl) }, configurable: true });
+  };
+
+  it('returns the pubky from the userHandle', async () => {
+    mockGet(async () => ({
+      rawId: new Uint8Array([1, 2, 3]).buffer,
+      response: { userHandle: new TextEncoder().encode(vectors.credentialId.pubky).buffer },
+    }));
+    const request = await buildPasskeyRequest({ authorizationUrl: 'pubkyauth://x', rpId: RP_ID, route: 'challenge' });
+    await expect(getPasskeyAssertion(request)).resolves.toEqual({
+      pubky: vectors.credentialId.pubky,
+      credentialId: 'AQID',
+    });
+  });
+
+  it('reports a cancelled sheet', async () => {
+    mockGet(async () => {
+      throw new DOMException('cancelled', 'NotAllowedError');
+    });
+    const request = await buildPasskeyRequest({ authorizationUrl: 'pubkyauth://x', rpId: RP_ID, route: 'challenge' });
+    await expect(getPasskeyAssertion(request)).rejects.toMatchObject({ reason: 'cancelled' });
+  });
+
+  it('refuses an assertion without a userHandle', async () => {
+    mockGet(async () => ({ rawId: new ArrayBuffer(1), response: { userHandle: null } }));
+    const request = await buildPasskeyRequest({ authorizationUrl: 'pubkyauth://x', rpId: RP_ID, route: 'challenge' });
+    await expect(getPasskeyAssertion(request)).rejects.toBeInstanceOf(PasskeyCeremonyError);
+  });
+});
+
+describe('isPasskeySignInSupported', () => {
+  beforeEach(() => {
+    Object.defineProperty(window, 'isSecureContext', { value: true, configurable: true });
+    Object.defineProperty(window, 'PublicKeyCredential', {
+      value: function PublicKeyCredential() {},
+      configurable: true,
+    });
+    Object.defineProperty(navigator, 'credentials', { value: { get: vi.fn() }, configurable: true });
+  });
+
+  afterEach(() => {
+    window.localStorage.clear();
+    window.history.replaceState(null, '', '/');
+  });
+
+  it('is on for mobile browsers with WebAuthn', () => {
+    expect(isPasskeySignInSupported()).toBe(true);
+  });
+
+  it('can be turned off with a query parameter or localStorage', () => {
+    window.history.replaceState(null, '', '/?ringPasskey=0');
+    expect(isPasskeySignInSupported()).toBe(false);
+    window.history.replaceState(null, '', '/');
+    window.localStorage.setItem('pubky-ring-passkey-disabled', 'true');
+    expect(isPasskeySignInSupported()).toBe(false);
+  });
+});
+
+describe('association files', () => {
+  it('serve nothing until configured', () => {
+    expect(getPasskeyAssetLinks({})).toEqual([]);
+    expect(getAppleAppSiteAssociation({})).toEqual({ webcredentials: { apps: [] } });
+  });
+
+  it('list the configured apps', () => {
+    expect(getPasskeyAssetLinks({ PASSKEY_ANDROID_CERT_SHA256: 'aa:bb, cc:dd' })).toEqual([
+      {
+        relation: ['delegate_permission/common.get_login_creds'],
+        target: {
+          namespace: 'android_app',
+          package_name: 'to.pubky.ring',
+          sha256_cert_fingerprints: ['AA:BB', 'CC:DD'],
+        },
+      },
+    ]);
+    expect(getAppleAppSiteAssociation({ PASSKEY_IOS_APP_IDS: 'TEAMID.app.example.ring' })).toEqual({
+      webcredentials: { apps: ['TEAMID.app.example.ring'] },
+    });
+  });
+});
diff --git a/src/libs/passkey/passkey.ts b/src/libs/passkey/passkey.ts
new file mode 100644
index 00000000..4a5cd871
--- /dev/null
+++ b/src/libs/passkey/passkey.ts
@@ -0,0 +1,158 @@
+import {
+  getPasskeyRpId,
+  PASSKEY_CEREMONY_TIMEOUT_MS,
+  PASSKEY_DISABLE_QUERY,
+  PASSKEY_DISABLE_STORAGE_KEY,
+  PASSKEY_ENVELOPE_LIFETIME_S,
+  PASSKEY_ROUTE_QUERY,
+} from '@/config/passkey';
+import { isAndroidIntentDevice, isIosDevice } from '@/libs/pwa/platform';
+import { base64UrlEncode, encodeEnvelope, ENVELOPE_NONCE_LENGTH, randomBytes } from './envelope';
+import { postMailbox, sealMailbox } from './mailbox';
+
+/**
+ * How the envelope reaches Ring:
+ * - `challenge`: Android. Credential Manager passes the full request JSON, including the challenge.
+ * - `mailbox`: iOS 18+. The envelope waits on the relay under a key derived from the PRF input.
+ * - `allowCredentials`: iOS 17 experiment. The envelope is sent as a credential ID. Undocumented.
+ */
+export type PasskeyRoute = 'challenge' | 'mailbox' | 'allowCredentials';
+
+export interface PasskeyAssertion {
+  /** z-base-32 pubky Ring returned as the WebAuthn userHandle. */
+  pubky: string;
+  credentialId: string;
+}
+
+export class PasskeyCeremonyError extends Error {
+  constructor(
+    readonly reason: 'unsupported' | 'cancelled' | 'mailbox' | 'no-user-handle' | 'failed',
+    message: string,
+    readonly cause?: unknown,
+  ) {
+    super(message);
+    this.name = 'PasskeyCeremonyError';
+  }
+}
+
+const readFlag = (name: string): string | null => {
+  try {
+    return new URLSearchParams(window.location.search).get(name);
+  } catch {
+    return null;
+  }
+};
+
+/** Mobile browsers with WebAuthn, unless turned off with `?ringPasskey=0` or the localStorage switch. */
+export function isPasskeySignInSupported(): boolean {
+  if (typeof window === 'undefined' || !window.isSecureContext) return false;
+  if (typeof window.PublicKeyCredential === 'undefined' || !navigator.credentials?.get) return false;
+  const queryFlag = readFlag(PASSKEY_DISABLE_QUERY);
+  if (queryFlag === '0' || queryFlag === 'false') return false;
+  try {
+    if (window.localStorage.getItem(PASSKEY_DISABLE_STORAGE_KEY) === 'true') return false;
+  } catch {
+    // Storage can be unavailable in private modes; the passkey path stays on.
+  }
+  return isIosDevice() || isAndroidIntentDevice();
+}
+
+export function defaultPasskeyRoute(): PasskeyRoute {
+  if (!isIosDevice()) return 'challenge';
+  return readFlag(PASSKEY_ROUTE_QUERY) === 'allowCredentials' ? 'allowCredentials' : 'mailbox';
+}
+
+export interface PasskeyRequest {
+  options: CredentialRequestOptions;
+  envelope: Uint8Array<ArrayBuffer>;
+  mailbox?: { channel: string; body: Uint8Array<ArrayBuffer> };
+}
+
+export async function buildPasskeyRequest({
+  authorizationUrl,
+  rpId = getPasskeyRpId(),
+  route = defaultPasskeyRoute(),
+  nowSeconds = Math.floor(Date.now() / 1000),
+  signal,
+}: {
+  authorizationUrl: string;
+  rpId?: string;
+  route?: PasskeyRoute;
+  nowSeconds?: number;
+  signal?: AbortSignal;
+}): Promise<PasskeyRequest> {
+  const envelope = encodeEnvelope({
+    exp: nowSeconds + PASSKEY_ENVELOPE_LIFETIME_S,
+    nonce: randomBytes(ENVELOPE_NONCE_LENGTH),
+    url: authorizationUrl,
+  }) as Uint8Array<ArrayBuffer>;
+  const prfInput = randomBytes(32);
+  const mailbox = route === 'mailbox' ? await sealMailbox({ prfInput, envelope, rpId }) : undefined;
+  const publicKey: PublicKeyCredentialRequestOptions & { hints?: string[] } = {
+    challenge: envelope,
+    rpId,
+    allowCredentials: route === 'allowCredentials' ? [{ type: 'public-key', id: envelope }] : [],
+    userVerification: 'preferred',
+    timeout: PASSKEY_CEREMONY_TIMEOUT_MS,
+    // Keep the request on this phone: a cross-device (hybrid QR) passkey cannot be Ring here.
+    hints: ['client-device'],
+    extensions: { prf: { eval: { first: prfInput } } } as AuthenticationExtensionsClientInputs,
+  };
+  return { options: { publicKey, ...(signal ? { signal } : {}) }, envelope, mailbox };
+}
+
+/** Builds the request and, on the mailbox route, leaves the sealed envelope on the relay. */
+export async function preparePasskeyRequest({
+  authorizationUrl,
+  relay,
+  route,
+  signal,
+}: {
+  authorizationUrl: string;
+  relay: string;
+  route?: PasskeyRoute;
+  signal?: AbortSignal;
+}): Promise<PasskeyRequest> {
+  if (!isPasskeySignInSupported()) throw new PasskeyCeremonyError('unsupported', 'Passkey sign-in is not supported');
+  const request = await buildPasskeyRequest({ authorizationUrl, route, signal });
+  if (request.mailbox) {
+    try {
+      await postMailbox({ relay, ...request.mailbox, signal });
+    } catch (error) {
+      throw new PasskeyCeremonyError('mailbox', 'Could not reach the relay', error);
+    }
+  }
+  return request;
+}
+
+/**
+ * Runs the WebAuthn ceremony that hands the Pubky grant request to Ring. Ring posts the signed
+ * approval to the relay before it returns, so the caller's `awaitApproval` delivers the session.
+ * The assertion itself is not a credential: callers only use its userHandle to check that the
+ * approving pubky is the one the user picked in the OS sheet.
+ *
+ * `navigator.credentials.get` is called synchronously, so a click handler keeps its user activation.
+ */
+export async function getPasskeyAssertion(request: PasskeyRequest): Promise<PasskeyAssertion> {
+  let credential: Credential | null;
+  try {
+    credential = await navigator.credentials.get(request.options);
+  } catch (error) {
+    const name = error instanceof DOMException ? error.name : '';
+    throw new PasskeyCeremonyError(
+      name === 'NotAllowedError' || name === 'AbortError' ? 'cancelled' : 'failed',
+      error instanceof Error ? error.message : 'Passkey request failed',
+      error,
+    );
+  }
+  const assertion = credential as PublicKeyCredential | null;
+  const response = assertion?.response as AuthenticatorAssertionResponse | undefined;
+  const userHandle = response?.userHandle;
+  if (!assertion || !userHandle || userHandle.byteLength === 0) {
+    throw new PasskeyCeremonyError('no-user-handle', 'The passkey did not identify a pubky');
+  }
+  return {
+    pubky: new TextDecoder().decode(userHandle),
+    credentialId: base64UrlEncode(new Uint8Array(assertion.rawId)),
+  };
+}
