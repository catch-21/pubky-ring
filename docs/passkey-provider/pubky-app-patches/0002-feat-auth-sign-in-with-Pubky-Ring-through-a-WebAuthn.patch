+type Env = Record<string, string | undefined>;
+
+const list = (value: string | undefined): string[] =>
+  (value ?? '')
+    .split(',')
+    .map((item) => item.trim())
+    .filter(Boolean);
+
+/** Pubky Ring's Android application ID. */
+export const DEFAULT_ANDROID_PACKAGE = 'to.pubky.ring';
+
+export function getPasskeyAssetLinks(env: Env) {
+  const fingerprints = list(env.PASSKEY_ANDROID_CERT_SHA256).map((fingerprint) => fingerprint.toUpperCase());
+  if (fingerprints.length === 0) return [];
+  return [
+    {
+      relation: ['delegate_permission/common.get_login_creds'],
+      target: {
+        namespace: 'android_app',
+        package_name: env.PASSKEY_ANDROID_PACKAGE?.trim() || DEFAULT_ANDROID_PACKAGE,
+        sha256_cert_fingerprints: fingerprints,
+      },
+    },
+  ];
+}
+
+export function getAppleAppSiteAssociation(env: Env) {
+  return { webcredentials: { apps: list(env.PASSKEY_IOS_APP_IDS) } };
+}
diff --git a/src/libs/passkey/envelope.ts b/src/libs/passkey/envelope.ts
new file mode 100644
index 00000000..a089778b
--- /dev/null
+++ b/src/libs/passkey/envelope.ts
@@ -0,0 +1,53 @@
+/**
+ * Pubky WebAuthn envelope ("E"), carried in the WebAuthn challenge (Android) or the iOS PRF
+ * mailbox. Byte layout, all integers big-endian, shared with Pubky Ring
+ * (src/passkey/envelope.ts and ios/PubkyPasskeyExtension):
+ *
+ *   "PKYWA1" (6) | version u8 | flags u8 | exp u32 (unix s) | nonce (16) | urlLen u16 | URL (UTF-8)
+ */
+
+const MAGIC = new TextEncoder().encode('PKYWA1');
+export const ENVELOPE_VERSION = 1;
+export const ENVELOPE_NONCE_LENGTH = 16;
+const HEADER_LENGTH = MAGIC.length + 1 + 1 + 4 + ENVELOPE_NONCE_LENGTH + 2;
+const MAX_URL_LENGTH = 4096;
+
+export interface PubkyEnvelopeInput {
+  exp: number;
+  nonce: Uint8Array;
+  url: string;
+  version?: number;
+  flags?: number;
+}
+
+export function encodeEnvelope({ exp, nonce, url, version = ENVELOPE_VERSION, flags = 0 }: PubkyEnvelopeInput) {
+  if (nonce.length !== ENVELOPE_NONCE_LENGTH) throw new Error('Envelope nonce must be 16 bytes');
+  const urlBytes = new TextEncoder().encode(url);
+  if (urlBytes.length > MAX_URL_LENGTH) throw new Error('Envelope URL is too long');
+  const out = new Uint8Array(HEADER_LENGTH + urlBytes.length);
+  const view = new DataView(out.buffer);
+  out.set(MAGIC, 0);
+  out[6] = version;
+  out[7] = flags;
+  view.setUint32(8, exp);
+  out.set(nonce, 12);
+  view.setUint16(12 + ENVELOPE_NONCE_LENGTH, urlBytes.length);
+  out.set(urlBytes, HEADER_LENGTH);
+  return out;
+}
+
+export function base64UrlEncode(bytes: Uint8Array): string {
+  let binary = '';
+  for (const byte of bytes) binary += String.fromCharCode(byte);
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+export function base64UrlDecode(value: string): Uint8Array {
+  const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+  const binary = atob(base64 + '='.repeat((4 - (base64.length % 4)) % 4));
+  return Uint8Array.from(binary, (char) => char.charCodeAt(0));
+}
+
+export function randomBytes(length: number): Uint8Array<ArrayBuffer> {
+  return crypto.getRandomValues(new Uint8Array(length));
+}
diff --git a/src/libs/passkey/mailbox.ts b/src/libs/passkey/mailbox.ts
new file mode 100644
index 00000000..184f847f
--- /dev/null
+++ b/src/libs/passkey/mailbox.ts
@@ -0,0 +1,81 @@
+import { base64UrlEncode, randomBytes } from './envelope';
+
+/**
+ * iOS request mailbox. iOS gives a passkey provider the rpId and the PRF input, but not the
+ * challenge, so the page leaves the envelope on the HTTP relay under a channel and key that only
+ * someone holding the PRF input can derive. Providers receive the PRF salt
+ * s = SHA-256("WebAuthn PRF" || 0x00 || r), so everything is derived from s.
+ */
+const DOMAIN = 'pubky-ring-webauthn-mailbox-v1';
+const encoder = new TextEncoder();
+
+const concat = (...parts: Uint8Array[]): Uint8Array<ArrayBuffer> => {
+  const out = new Uint8Array(parts.reduce((length, part) => length + part.length, 0));
+  let offset = 0;
+  for (const part of parts) {
+    out.set(part, offset);
+    offset += part.length;
+  }
+  return out;
+};
+
+const sha256 = async (...parts: Uint8Array[]): Promise<Uint8Array<ArrayBuffer>> =>
+  new Uint8Array(await crypto.subtle.digest('SHA-256', concat(...parts)));
+
+export const prfSalt = (prfInput: Uint8Array) => sha256(encoder.encode('WebAuthn PRF'), new Uint8Array([0]), prfInput);
+
+export async function mailboxKeyBytes(salt: Uint8Array): Promise<Uint8Array<ArrayBuffer>> {
+  const ikm = await crypto.subtle.importKey('raw', concat(salt), 'HKDF', false, ['deriveBits']);
+  const bits = await crypto.subtle.deriveBits(
+    { name: 'HKDF', hash: 'SHA-256', salt: new Uint8Array(0), info: encoder.encode(`${DOMAIN}/key`) },
+    ikm,
+    256,
+  );
+  return new Uint8Array(bits);
+}
+
+export const mailboxChannel = async (salt: Uint8Array): Promise<string> =>
+  base64UrlEncode(await sha256(encoder.encode(`${DOMAIN}/channel`), salt));
+
+/** body = gcmNonce (12) || AES-256-GCM(key, gcmNonce, envelope, aad = rpId) */
+export async function sealMailbox({
+  prfInput,
+  envelope,
+  rpId,
+  gcmNonce = randomBytes(12),
+}: {
+  prfInput: Uint8Array;
+  envelope: Uint8Array;
+  rpId: string;
+  gcmNonce?: Uint8Array;
+}): Promise<{ channel: string; body: Uint8Array<ArrayBuffer> }> {
+  const salt = await prfSalt(prfInput);
+  const key = await crypto.subtle.importKey('raw', await mailboxKeyBytes(salt), 'AES-GCM', false, ['encrypt']);
+  const ciphertext = await crypto.subtle.encrypt(
+    { name: 'AES-GCM', iv: concat(gcmNonce), additionalData: encoder.encode(rpId) },
+    key,
+    concat(envelope),
+  );
+  return { channel: await mailboxChannel(salt), body: concat(gcmNonce, new Uint8Array(ciphertext)) };
+}
+
+/** Leaves the sealed envelope on the relay inbox, where Ring's extension fetches it. */
+export async function postMailbox({
+  relay,
+  channel,
+  body,
+  signal,
+}: {
+  relay: string;
+  channel: string;
+  body: Uint8Array<ArrayBuffer>;
+  signal?: AbortSignal;
+}): Promise<void> {
+  const response = await fetch(`${relay.replace(/\/+$/, '')}/${channel}`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/octet-stream' },
+    body,
+    signal,
+  });
+  if (!response.ok) throw new Error(`Mailbox relay responded ${response.status}`);
+}
